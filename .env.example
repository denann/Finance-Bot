# Finance Bot configuration
#
# FOR FIRST-TIME USERS: fill only the five values below, then run:
#   python scripts/setup_check.py
# Keep this file as a template. Put your real values only in .env.

# 1. Token from @BotFather
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# 2. Your numeric Telegram user ID (the bot is private to this account)
ALLOWED_USER_ID=replace_with_your_telegram_user_id

# 3. Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEET_ID=replace_with_google_sheet_id

# 4. File path for the downloaded Google service-account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# 5. Gemini API key for receipt parsing and AI finance features
GEMINI_API_KEY=replace_with_gemini_api_key

# Normal local use needs no other setting. The bot uses polling, Asia/Jakarta,
# one scheduler, safe timeouts, default Gemini models, and JSON logs automatically.

# -----------------------------------------------------------------------------
# ADVANCED / DEPLOYMENT SETTINGS
# Leave these commented unless you understand why you need to change them.
# -----------------------------------------------------------------------------

# BOT_MODE=polling
# APP_PORT=8000
# APP_TIMEZONE=Asia/Jakarta
# APP_INSTANCE_COUNT=1
# SCHEDULER_ENABLED=true
# LOG_LEVEL=INFO
# LOG_FILE=logs/finance_bot.log
# Privacy-sensitive local debugging only. It stores confirmed transaction IDs
# and the original finance input in the log file. Keep the file private.
# LOG_INCLUDE_FINANCE_DATA=false

# Webhook only. Polling users do not need these.
# TELEGRAM_WEBHOOK_SECRET=
# WEBHOOK_URL=

# Google Sheets reliability and performance tuning.
# SHEETS_MAX_RETRIES=5
# SHEETS_RETRY_BASE_DELAY=1.0
# SHEETS_TIMEOUT_SECONDS=20
# SHEETS_INTERACTIVE_CONCURRENCY=2
# SCHEDULED_WORK_CONCURRENCY=1
# SHEETS_REQUEST_ROW_BUDGET=50000
# TRANSACTION_SORT_MODE=server

# Gemini model and request-bound tuning.
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TEXT_MODEL=
# GEMINI_INTENT_MODEL=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash
# GEMINI_INSIGHT_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_CONCURRENCY=1
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_MAX_OUTPUT_CHARS=50000
# GEMINI_MAX_INPUT_CHARS=100000
# GEMINI_CALLS_PER_UPDATE=1
# AI_CONTEXT_RECORD_LIMIT=40

# Hidden, read-only diagnostic route. Keep disabled in normal use.
# ENABLE_TEST_SHEETS_ROUTE=false
# DIAGNOSTIC_ADMIN_SECRET=
