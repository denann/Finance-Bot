# Runtime
BOT_MODE=polling
APP_TIMEZONE=Asia/Jakarta
APP_INSTANCE_COUNT=1
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# Google Sheets
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SHEETS_MAX_RETRIES=3
SHEETS_RETRY_BASE_DELAY=0.5

# Optional web diagnostic. Keep disabled in production.
ENABLE_TEST_SHEETS_ROUTE=false
DIAGNOSTIC_ADMIN_SECRET=

# Gemini
# Current LLM provider support: Google Gemini only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_INTENT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite
GEMINI_INSIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_OUTPUT_CHARS=50000
